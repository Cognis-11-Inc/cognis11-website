---
import Arrow from './Arrow.astro';
import { publications, furtherRecords, researcher } from '../lib/publications';
import { manuscriptPath } from '../lib/publications';
import { sitePath } from '../lib/site';
---
<section class="publication-library" id="publications" aria-labelledby="publications-heading">
  <div class="research-section-heading"><p class="eyebrow">Published research · through v8.1</p><h2 id="publications-heading">Read the work. Follow its evolution.</h2><p>Versioned preprints and technical notes by Guillaume Heinerth. These records describe dated research snapshots and their limits; the engine and current implementation remain proprietary.</p></div>
  <div class="researcher-links"><a class="text-link" href={researcher.orcidUrl}>ORCID · {researcher.orcid}<Arrow diagonal /></a><a class="text-link" href={sitePath(manuscriptPath)}>Read the full v8.1 manuscript<Arrow diagonal /></a></div>
  {publications.map((publication) => <article class="publication-record" aria-labelledby={`publication-${publication.version}-heading`}>
    <div class="publication-version"><p class="eyebrow">Preprint · {publication.version}</p><time datetime={publication.date}>{new Date(`${publication.date}T12:00:00Z`).toLocaleDateString('en-CA', {year:'numeric', month:'long', day:'numeric', timeZone:'UTC'})}</time></div>
    <div><h3 id={`publication-${publication.version}-heading`}>{publication.title}</h3><p class="publication-summary">{publication.summary}</p>{publication.quote && <blockquote><p>“{publication.quote}”</p><cite>Guillaume Heinerth · public record abstract · {publication.version}</cite></blockquote>}<div class="publication-links"><a class="text-link" href={publication.record}>Read {publication.version} on Zenodo<Arrow diagonal /></a><a class="doi-link" href={`https://doi.org/${publication.doi}`}>{publication.doi}</a></div></div>
  </article>)}
  <details class="publication-index"><summary>More records from the research programme <span aria-hidden="true">+</span></summary><ul>{furtherRecords.map((record) => <li><a href={`https://doi.org/${record.doi}`}>{record.title}<span>{record.doi}</span></a></li>)}</ul></details>
</section>
<style>
  .publication-library { padding-block: 2rem 4rem; }
  .researcher-links { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin-bottom: 2rem; }
  .researcher-links .text-link { font-size: .78rem; color: #bdfbff; border-bottom: 1px solid var(--line); }
  .publication-record { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; padding-block: 2.7rem; border-top: 1px solid var(--line); }
  .publication-version .eyebrow { color: var(--accent); }
  time { color: var(--muted); font: .64rem/1.8 var(--font-mono); }
  h3 { font-size: clamp(1.4rem, 2.7vw, 2.25rem); letter-spacing: -.035em; line-height: 1.25; max-width: 42ch; }
  .publication-summary { max-width: 65ch; color: var(--muted); font-size: .95rem; }
  blockquote { margin: 1.5rem 0; border-left: 1px solid var(--accent-dim); padding-left: 1.3rem; }
  blockquote p { color: #bdfbff; font-size: 1.15rem; line-height: 1.5; margin-bottom: .75rem; }
  cite { color: var(--muted); font: normal .6rem/1.8 var(--font-mono); }
  .publication-links { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1.8rem; }
  .publication-links .text-link { font-size: .8rem; border-bottom: 1px solid var(--line); }
  .doi-link { display: inline-flex; align-items: center; min-height: 44px; font: .63rem/1.8 var(--font-mono); color: var(--muted); overflow-wrap: anywhere; }
  .publication-index { border-block: 1px solid var(--line); }
  .publication-index summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; padding: 1rem .4rem; cursor: pointer; list-style: none; font-size: .9rem; }
  .publication-index summary::-webkit-details-marker { display: none; }
  .publication-index summary span { color: var(--accent); font-size: 1.3rem; }
  .publication-index ul { list-style: none; padding: 0; margin: 0; }
  .publication-index li { border-top: 1px solid var(--line); }
  .publication-index li > a { display: block; padding: 1.1rem .4rem; font-size: .85rem; line-height: 1.7; text-decoration: none; }
  .publication-index li span { display: block; font: .6rem/1.8 var(--font-mono); color: var(--muted); overflow-wrap: anywhere; }
  @media(max-width:680px) { .publication-library { padding-bottom: 2.5rem; } .publication-record { grid-template-columns: 1fr; gap: 1rem; padding-block: 2rem; } .publication-version { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.2rem; } .publication-version p { margin: 0; } }
</style>
