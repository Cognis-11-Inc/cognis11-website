---
import Arrow from './Arrow.astro';
import { sitePath } from '../lib/site';
---

<figure class="encounter" data-encounter>
  <details class="instrument">
    <summary aria-label="Explore the symbolic instrument" aria-controls="encounter-revelation">
      <span class="instrument-stage">
        <svg class="instrument-object" viewBox="0 0 620 590" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="obsidian-left" x1="146" y1="280" x2="300" y2="280" gradientUnits="userSpaceOnUse">
              <stop stop-color="#010507" /><stop offset=".15" stop-color="#10212b" /><stop offset=".25" stop-color="#061017" /><stop offset=".85" stop-color="#010507" /><stop offset="1" stop-color="#0b2837" />
            </linearGradient>
            <linearGradient id="obsidian-right" x1="326" y1="200" x2="478" y2="340" gradientUnits="userSpaceOnUse">
              <stop stop-color="#163547" /><stop offset=".07" stop-color="#061017" /><stop offset=".7" stop-color="#010507" /><stop offset=".94" stop-color="#0b1922" /><stop offset="1" stop-color="#02090c" />
            </linearGradient>
            <linearGradient id="edge-light" x1="130" y1="80" x2="410" y2="520" gradientUnits="userSpaceOnUse">
              <stop stop-color="#bdfbff" stop-opacity=".6" /><stop offset=".35" stop-color="#0873df" stop-opacity=".25" /><stop offset=".8" stop-color="#bdfbff" stop-opacity=".08" /><stop offset="1" stop-color="#00c8ff" stop-opacity=".5" />
            </linearGradient>
            <linearGradient id="subsurface-light" x1="100" y1="300" x2="510" y2="300" gradientUnits="userSpaceOnUse">
              <stop stop-color="#08275e" /><stop offset=".45" stop-color="#00c8ff" /><stop offset=".55" stop-color="#22f5ff" /><stop offset="1" stop-color="#0d55d9" />
            </linearGradient>
            <radialGradient id="instrument-ground">
              <stop stop-color="#0873df" stop-opacity=".17" /><stop offset="1" stop-color="#000101" stop-opacity="0" />
            </radialGradient>
            <clipPath id="instrument-interior">
              <path d="m146 122 154-53 26 0 143 61 8 363-151-39h-26l-118 65-32-23Z" />
            </clipPath>
          </defs>

          <ellipse cx="310" cy="521" rx="235" ry="52" fill="url(#instrument-ground)" />
          <g clip-path="url(#instrument-interior)">
            <path d="M145 80h335v450H145z" fill="#010a10" />
            <g class="instrument-depth" stroke="#0873df" stroke-width=".8" opacity=".7">
              {Array.from({ length: 12 }, (_, i) => <path d={`M${158 + i * 12} 100C${150 + i * 14} 190 ${210 + i * 12} 280 ${170 + i * 16} 405L${200 + i * 13} 515`} />)}
              {Array.from({ length: 8 }, (_, i) => <path d={`M155 ${190 + i * 26}C255 ${120 + i * 28} 320 ${300 + i * 15} 470 ${240 + i * 28}`} />)}
            </g>
            <!-- A related trace family: authored illustration, not telemetry. -->
            <g class="instrument-signal" stroke="url(#subsurface-light)" stroke-linecap="round">
              <path d="M128 316C173 316 183 272 215 280S248 344 274 329 289 197 316 192 349 350 374 354 382 262 410 257 455 337 491 309" stroke-width="9" opacity=".09" />
              <path class="signal-trace" d="M128 316C173 316 183 272 215 280S248 344 274 329 289 197 316 192 349 350 374 354 382 262 410 257 455 337 491 309" stroke-width="2" />
              <path d="M128 320C178 316 185 293 215 295S244 371 273 356 297 251 316 249 347 348 374 341 389 288 410 291 463 331 491 314" stroke-width=".7" opacity=".65" />
              <path d="M165 321C200 324 221 336 245 314S293 261 316 282 351 331 380 318 447 291 480 315" stroke-width=".6" opacity=".45" />
            </g>
          </g>

          <g class="instrument-shell instrument-shell-left">
            <path d="m146 122 154-53v385l-118 65c-18 9-31-6-32-23Z" fill="url(#obsidian-left)" />
            <path d="m146 122 154-53v385l-118 65c-18 9-31-6-32-23Z" stroke="url(#edge-light)" stroke-width="1" />
            <path d="m154 127 139-47M157 135l4 351q0 14 12 13" stroke="#bdfbff" stroke-opacity=".16" stroke-width=".7" />
            <path d="M298 90v349" stroke="#00c8ff" stroke-opacity=".3" stroke-width=".7" />
            <path d="M183 126c29 85 27 196 7 349" stroke="#bdfbff" stroke-opacity=".035" stroke-width="13" />
          </g>
          <g class="instrument-shell instrument-shell-right">
            <path d="m326 69 143 61 8 363c0 13-7 22-19 17l-132-56Z" fill="url(#obsidian-right)" />
            <path d="m326 69 143 61 8 363c0 13-7 22-19 17l-132-56Z" stroke="url(#edge-light)" stroke-width="1" />
            <path d="m333 80 128 55 7 354" stroke="#bdfbff" stroke-opacity=".19" stroke-width=".7" />
            <path d="M327 87v354" stroke="#22f5ff" stroke-opacity=".4" stroke-width=".8" />
          </g>
          <path class="contact-seam" d="M313 170v240" stroke="url(#subsurface-light)" stroke-width="1" />
          <path d="m300 546 13 7 13-7" stroke="#335364" stroke-width=".7" />
        </svg>
        <span class="instrument-reflection" aria-hidden="true"></span>
      </span>
      <span class="instrument-affordance">
        <span class="contact-glyph" aria-hidden="true">+</span>
        <span class="instrument-invite">Touch the signal</span>
        <span class="instrument-close">Close the instrument</span>
        <span class="contact-arrow" aria-hidden="true">↗</span>
      </span>
    </summary>
    <div class="instrument-revelation" id="encounter-revelation">
      <p class="eyebrow">Contact → response → revelation</p>
      <h2>A gesture changes the encounter.</h2>
      <p>Here, your touch reveals a structure. Our question goes further: what can a system carry from one encounter to the next?</p>
      <a class="text-link" href={`${sitePath('research/')}#continuity`}>Explore continuity <Arrow /></a>
    </div>
  </details>
  <figcaption>Interactive illustration <span aria-hidden="true">/</span> No live intelligence connected.</figcaption>
</figure>

<script>
  let instrumentListeners: AbortController | undefined;
  function connectInstrument() {
  instrumentListeners?.abort();
  instrumentListeners = new AbortController();
  const { signal } = instrumentListeners;
  const encounter = document.querySelector<HTMLElement>('[data-encounter]');
  const stage = encounter?.querySelector<HTMLElement>('.instrument-stage');
  if (stage) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      stage.removeAttribute('style');
    };
    stage.addEventListener('pointermove', (event) => {
      if (motion.matches || event.pointerType !== 'mouse') return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const bounds = stage.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
        const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
        stage.style.setProperty('--contact-x', `${x * 100}%`);
        stage.style.setProperty('--contact-y', `${y * 100}%`);
        stage.style.setProperty('--lean-y', `${(x - .5) * 5}deg`);
        stage.style.setProperty('--lean-x', `${(.5 - y) * 4}deg`);
      });
    }, { signal });
    stage.addEventListener('pointerleave', reset, { signal });
    motion.addEventListener('change', reset, { signal });
    window.addEventListener('pagehide', reset, { once: true, signal });
  }
  }
  connectInstrument();
  document.addEventListener('astro:page-load', connectInstrument);
</script>

<style>
  .encounter { margin: 0; position: relative; width: 100%; }
  .instrument { position: relative; }
  summary { display: block; list-style: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: none; }
  summary:focus-visible .instrument-affordance { outline: 2px solid var(--accent); outline-offset: 5px; }
  .instrument-stage { position: relative; display: block; isolation: isolate; }
  .instrument-object { width: 100%; height: auto; transform: perspective(1000px) rotateX(var(--lean-x, 0deg)) rotateY(var(--lean-y, 0deg)) scale(calc(1 + var(--music-breath, 0) * .006 + var(--music-impact, 0) * .012)); transition: transform .2s ease-out; }
  .instrument-reflection { position: absolute; inset: 10% 18% 10% 18%; pointer-events: none; background: radial-gradient(ellipse 35% 30% at var(--contact-x, 50%) var(--contact-y, 40%), #bdfbff0a, transparent); opacity: 0; transition: opacity .3s; mix-blend-mode: screen; }
  summary:hover .instrument-reflection, summary:focus-visible .instrument-reflection { opacity: 1; }
  .instrument-shell { transition: transform var(--sonic-beat, .9s) cubic-bezier(.2,.7,.2,1), opacity var(--sonic-beat, .9s) ease; }
  .instrument-signal { opacity: .5; transition: opacity .5s ease; }
  .instrument-depth { opacity: .16; transition: opacity .7s ease; }
  .contact-seam { opacity: calc(.35 + var(--music-breath, 0) * .22); transition: opacity .3s ease; }
  summary:hover .contact-seam, summary:focus-visible .contact-seam { opacity: 1; }
  .instrument[open] .instrument-shell-left { transform: translateX(-24px); opacity: .48; }
  .instrument[open] .instrument-shell-right { transform: translateX(24px); opacity: .48; }
  .instrument[open] .instrument-signal, .instrument[open] .instrument-depth { opacity: 1; }
  .instrument[open] .contact-seam { opacity: 0; }
  .encounter[data-echo='eclipse'] .instrument-shell, .encounter[data-echo='eleventh'] .instrument-shell { opacity: .15; }
  .encounter[data-echo='counterflow'] .instrument-depth { transform: rotate(180deg); transform-origin: 310px 295px; opacity: .75; }
  .encounter[data-echo='paradox'] .instrument-signal { opacity: 1; transform: scaleY(-1); transform-origin: 310px 295px; }
  .instrument[open] .signal-trace { stroke-dasharray: 700; animation: signal-reveal 1.1s ease-out both; }
  .instrument-affordance { display: flex; align-items: center; gap: .85rem; min-height: 56px; width: fit-content; margin: -.5rem auto 0; padding: .5rem 1.2rem; border-bottom: 1px solid var(--line); font-size: .85rem; color: var(--text); transition: color .2s, border-color .2s; }
  summary:hover .instrument-affordance, summary:focus-visible .instrument-affordance, .instrument[open] .instrument-affordance { border-color: var(--accent-dim); color: var(--accent); }
  .contact-glyph { font: 1.25rem var(--font-mono); color: var(--accent); transition: transform .4s; }
  .instrument[open] .contact-glyph { transform: rotate(45deg); }
  .contact-arrow { margin-left: 1rem; color: var(--accent); }
  .instrument-close, .instrument[open] .instrument-invite { display: none; }
  .instrument[open] .instrument-close { display: inline; }
  .instrument-revelation { margin: 1.5rem auto 0; max-width: 390px; padding: 1.5rem; border-left: 1px solid var(--accent-dim); background: var(--surface-raised); }
  .instrument-revelation .eyebrow { font-size: .57rem; color: var(--accent); }
  .instrument-revelation h2 { font-size: 1.4rem; line-height: 1.2; letter-spacing: -.03em; margin-bottom: .8rem; }
  .instrument-revelation p:not(.eyebrow) { font-size: .85rem; color: var(--muted); margin-bottom: .6rem; }
  .instrument-revelation .text-link { font-size: .78rem; }
  figcaption { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .45rem; padding: 1.2rem .5rem 0; color: var(--muted); font: .55rem/1.7 var(--font-mono); text-align: center; }
  @keyframes signal-reveal { from { stroke-dashoffset: 700; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .instrument-object { transform: none; } }
</style>
