---
interface Props { id: string; title: string; items: readonly { question: string; answer: string }[]; }
const { id, title, items } = Astro.props;
---
<section class="reading-questions" id={id} aria-labelledby={`${id}-heading`}>
  <p class="eyebrow">Before the conversation</p>
  <h2 id={`${id}-heading`}>{title}</h2>
  <div>{items.map((item) => <details name={id}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
</section>
<style>
  .reading-questions { padding-block: 3rem; border-top: 1px solid var(--line); }
  .reading-questions > .eyebrow { color: var(--accent); font-size: .6rem; }
  h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); letter-spacing: -.04em; margin-bottom: 2rem; }
  details { border-bottom: 1px solid var(--line); }
  details:first-child { border-top: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 72px; padding: 1rem .5rem; cursor: pointer; list-style: none; font-size: clamp(1rem, 1.5vw, 1.2rem); }
  summary::-webkit-details-marker { display: none; }
  summary > span { color: var(--accent); font: 1.3rem var(--font-mono); }
  details[open] summary { color: var(--accent); }
  details[open] summary > span { transform: rotate(45deg); }
  details > p { color: var(--muted); font-size: .95rem; max-width: 72ch; padding: .5rem .5rem 1.2rem; margin: 0; }
  @media (max-width: 680px) { .reading-questions { padding-block: 2.2rem; } }
</style>
