---
interface Props {
  id: string;
  label: string;
  title: string;
  intro?: string;
  items: readonly { title: string; body: string }[];
}
const { id, label, title, intro, items } = Astro.props;
---
<section class="reading-section" id={id} aria-labelledby={`${id}-heading`}>
  <div class="reading-heading"><p class="eyebrow">{label}</p><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}</div>
  <div class:list={['reading-grid', { 'reading-grid-pairs': items.length === 4 }]}>
    {items.map((item, index) => <article><span class="eyebrow reading-index">{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
  </div>
</section>
<style>
  .reading-section { padding-block: 3.2rem; border-top: 1px solid var(--line); }
  .reading-heading { max-width: 70ch; margin-bottom: 2.2rem; }
  .reading-heading > .eyebrow { color: var(--accent); font-size: .6rem; }
  h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); line-height: 1.15; letter-spacing: -.04em; margin-bottom: 1.1rem; }
  .reading-heading > p:not(.eyebrow) { color: var(--muted); font-size: .95rem; }
  .reading-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem; }
  .reading-grid-pairs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  article { padding: 1.5rem 1.4rem; border-left: 1px solid var(--line); background: linear-gradient(135deg, var(--surface-raised), transparent); }
  .reading-index { display: block; color: var(--accent); font-size: .6rem; margin-bottom: 1.5rem; }
  h3 { font-size: 1.3rem; line-height: 1.3; letter-spacing: -.03em; margin-bottom: 1rem; }
  article > p { color: var(--muted); font-size: .9rem; margin: 0; max-width: 51ch; }
  @media (max-width: 800px) { .reading-grid { gap: 1rem; } article { padding-inline: 1rem; } }
  @media (max-width: 680px) { .reading-section { padding-block: 2.2rem; } .reading-grid, .reading-grid-pairs { grid-template-columns: 1fr; } .reading-index { margin-bottom: 1rem; } }
</style>
