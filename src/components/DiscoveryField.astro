<section class="discovery-section shell" aria-labelledby="discovery-heading" data-discovery hidden>
  <div class="discovery-intro">
    <p class="eyebrow">An invitation to doubt</p>
    <h2 id="discovery-heading">What are you<br />rejecting?</h2>
    <p>The unfamiliar. A contradiction. Your own first answer.</p>
    <p>Disturb the field. Follow what resists your explanation.</p>
    <p class="discovery-hint">Some things answer twice.<br />One signal repeats: <span>11</span>.</p>
  </div>
  <div class="discovery-lab" data-visual="trace">
    <button class="field-control" type="button" aria-label="Look again: disturb the field" aria-controls="discovery-response">
      <svg viewBox="0 0 600 390" fill="none" aria-hidden="true">
        <defs>
          <radialGradient id="field-aura"><stop stop-color="#00b8ff" stop-opacity=".17"/><stop offset="1" stop-color="#000101" stop-opacity="0"/></radialGradient>
          <linearGradient id="field-signal"><stop stop-color="#08275e"/><stop offset=".45" stop-color="#22f5ff"/><stop offset="1" stop-color="#0d55d9"/></linearGradient>
          <radialGradient id="field-eclipse"><stop offset=".75" stop-color="#000101"/><stop offset=".89" stop-color="#000101"/><stop offset=".94" stop-color="#00b8ff" stop-opacity=".35"/><stop offset=".965" stop-color="#bdfbff"/><stop offset=".98" stop-color="#22f5ff" stop-opacity=".4"/><stop offset="1" stop-color="#000101" stop-opacity="0"/></radialGradient>
        </defs>
        <ellipse class="field-aura" cx="300" cy="200" rx="260" ry="185" fill="url(#field-aura)"/>
        <g class="field-grid" stroke="#1a2b34" stroke-width=".6">
          <path d="M35 195h530M300 25v340"/>
          <circle cx="300" cy="195" r="144" stroke-dasharray="2 13"/>
          <path d="m86 330 428-270M86 60l428 270" opacity=".25"/>
        </g>
        <g class="field-orbits" stroke="url(#field-signal)" stroke-width="1">
          <ellipse cx="300" cy="195" rx="202" ry="57" transform="rotate(-27 300 195)"/>
          <ellipse cx="300" cy="195" rx="174" ry="91" transform="rotate(27 300 195)" opacity=".6"/>
          <ellipse cx="300" cy="195" rx="113" ry="151" transform="rotate(-13 300 195)" opacity=".4"/>
        </g>
        <g class="field-weave" stroke="url(#field-signal)" stroke-width=".8">
          {Array.from({length: 11}, (_, i) => <path d={`M${110 + i * 5} ${245 - i * 12}C${195 + i * 8} ${5 + i * 15} ${330 - i * 8} ${380 - i * 11} ${490 - i * 4} ${145 + i * 9}`} opacity={.22 + i * .06}/>)}
        </g>
        <g class="field-stars" fill="#bdfbff">
          {Array.from({length: 11}, (_, i) => <circle cx={300 + Math.cos(i / 11 * Math.PI * 2) * 145} cy={195 + Math.sin(i / 11 * Math.PI * 2) * 145} r={i % 3 === 0 ? 2 : 1}/>)}
        </g>
        <circle class="field-core" cx="300" cy="195" r="53" fill="#000101" stroke="#22f5ff" stroke-opacity=".45"/>
        <circle class="field-sun" cx="300" cy="195" r="109" fill="url(#field-eclipse)"/>
        <g class="field-paradox" stroke="#22f5ff" stroke-width="1.2">
          <path d="M172 195c0-93 128-93 128 0s128 93 128 0-128-93-128 0-128 93-128 0Z"/>
          <path d="M172 195c0 93 128 93 128 0s128-93 128 0-128 93-128 0-128-93-128 0Z" opacity=".4"/>
        </g>
        <path class="field-cursor" d="m295 190 10 10m0-10-10 10" stroke="#bdfbff"/>
      </svg>
      <span class="field-action">Look again <span aria-hidden="true">+</span></span>
    </button>
    <div id="discovery-response" class="discovery-response" aria-live="polite" aria-atomic="true">
      <p class="eyebrow" data-fragment-tier>Unresolved</p>
      <h3 data-fragment-title>Begin with what you dismiss.</h3>
      <p data-fragment-text>One gesture. A different way to look.</p>
    </div>
    <div class="discovery-bottom">
      <details class="fragment-archive" hidden><summary>Fragments recovered <span data-fragment-count>0</span></summary><ul data-fragment-list></ul></details>
      <button class="eleven-control" type="button" aria-label="Follow signal 11">11<span aria-hidden="true">↗</span></button>
    </div>
  </div>
</section>

<script>
  import { fragments, chooseFragment, type FragmentId } from '../lib/discoveries';
  const recovered = new Set<FragmentId>();
  const questions = new Set<string>();
  let homeSeen = false;
  let instrumentOpens = 0;
  let encounters = 0;
  let lastRare = -Infinity;
  let listeners: AbortController | undefined;
  try {
    const saved = JSON.parse(sessionStorage.getItem('cognis11:fragments:v1') || 'null');
    if (saved && Array.isArray(saved.recovered)) for (const id of saved.recovered) if (typeof id === 'string' && Object.hasOwn(fragments, id)) recovered.add(id as FragmentId);
    if (saved && Array.isArray(saved.questions)) for (const key of saved.questions) if (typeof key === 'string') questions.add(key);
    homeSeen = saved?.homeSeen === true;
  } catch { /* Discoveries remain usable when storage is unavailable. */ }
  function connect() {
    const root = document.querySelector<HTMLElement>('[data-discovery]');
    if (root?.dataset.discoveryReady === 'true') return;
    listeners?.abort();
    if (!root) return;
    listeners = new AbortController();
    const { signal } = listeners;
    const lab = root.querySelector<HTMLElement>('.discovery-lab')!;
    const tier = root.querySelector<HTMLElement>('[data-fragment-tier]')!;
    const title = root.querySelector<HTMLElement>('[data-fragment-title]')!;
    const text = root.querySelector<HTMLElement>('[data-fragment-text]')!;
    const archive = root.querySelector<HTMLDetailsElement>('.fragment-archive')!;
    const list = root.querySelector<HTMLElement>('[data-fragment-list]')!;
    const count = root.querySelector<HTMLElement>('[data-fragment-count]')!;
    const save = () => {
      try { sessionStorage.setItem('cognis11:fragments:v1', JSON.stringify({recovered:[...recovered], questions:[...questions], homeSeen})); } catch { /* Optional session continuity. */ }
    };
    const refreshArchive = () => {
      count.textContent = String(recovered.size);
      list.replaceChildren(...[...recovered].map((id) => {
        const item = document.createElement('li'); item.textContent = fragments[id].title; return item;
      }));
      archive.hidden = recovered.size === 0;
    };
    const reveal = (id: FragmentId) => {
      const fragment = fragments[id];
      recovered.add(id);
      tier.textContent = fragment.tier; title.textContent = fragment.title; text.textContent = fragment.text;
      lab.dataset.visual = fragment.visual; lab.classList.add('has-contact');
      const encounter = document.querySelector<HTMLElement>('[data-encounter]');
      if (encounter) encounter.dataset.echo = fragment.visual;
      if (id === 'eclipse' || id === 'eleventh') lastRare = performance.now();
      refreshArchive(); save();
      document.dispatchEvent(new CustomEvent('cognis:discovery'));
    };
    root.querySelector('.field-control')!.addEventListener('click', () => {
      const draw = crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296;
      reveal(chooseFragment(encounters++, draw, performance.now() - lastRare > 30000));
    }, { signal });
    root.querySelector('.eleven-control')!.addEventListener('click', () => reveal('paradox'), { signal });
    let keys = ''; let lastKey = 0;
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || event.repeat || (event.target instanceof Element && event.target.closest('input, textarea, select, button, a, [contenteditable]'))) return;
      if (performance.now() - lastKey > 2000) keys = '';
      keys = (keys + event.key).slice(-2); lastKey = performance.now();
      if (keys === '11') { reveal('paradox'); keys = ''; }
    }, { signal });
    document.addEventListener('toggle', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLDetailsElement) || !target.open) return;
      if (target.classList.contains('instrument') && ++instrumentOpens === 3 && !recovered.has('echo')) reveal('echo');
      if (target.classList.contains('research-question')) {
        const question = target.querySelector('.question-title')?.textContent;
        if (question) questions.add(question.trim());
        if (questions.size >= 4 && !recovered.has('fifth')) reveal('fifth');
        save();
      }
    }, { capture: true, signal });
    root.dataset.discoveryReady = 'true'; root.hidden = false;
    refreshArchive();
    if (homeSeen && !recovered.has('return')) reveal('return');
    homeSeen = true; save();
  }
  connect();
  document.addEventListener('astro:page-load', connect);
</script>

<style>
  .discovery-section[hidden] { display: none; }
  .discovery-section { display: grid; grid-template-columns: 1fr 1.35fr; gap: 4rem; padding-block: 3rem 6rem; }
  .discovery-intro { padding-top: 3rem; }
  .discovery-intro > .eyebrow { color: var(--accent); margin-bottom: 2rem; }
  .discovery-intro h2 { font-size: clamp(2.6rem, 5vw, 4.5rem); line-height: 1.06; letter-spacing: -.055em; }
  .discovery-intro > p:not(.eyebrow) { color: var(--muted); max-width: 35ch; font-size: .95rem; }
  .discovery-intro .discovery-hint { margin-top: 2.5rem; font: .64rem/1.9 var(--font-mono); }
  .discovery-hint span { color: var(--accent); }
  .discovery-lab { min-width: 0; border: 1px solid var(--line); background: radial-gradient(ellipse at 50% 25%, #041015, #000101 70%); }
  .field-control { display: block; width: 100%; border: 0; padding: 0 1rem .5rem; background: transparent; color: var(--text); cursor: pointer; }
  .field-control svg { width: 100%; height: auto; overflow: visible; }
  .field-control:focus-visible { outline-offset: 3px; }
  .field-action { display: flex; justify-content: space-between; align-items: center; gap: 1rem; width: fit-content; min-height: 44px; margin: 0 auto; padding-inline: .5rem; border-bottom: 1px solid var(--line); font-size: .78rem; }
  .field-action > span { color: var(--accent); font-size: 1.25rem; }
  .field-control:hover .field-action { color: var(--accent); border-color: var(--accent-dim); }
  .field-orbits, .field-weave, .field-stars, .field-core, .field-sun, .field-paradox { transform-origin: 300px 195px; transition: opacity 1.3s ease, transform 2.4s cubic-bezier(.2,.7,.2,1); }
  .field-weave { opacity: .75; }
  .field-stars, .field-sun, .field-paradox { opacity: 0; }
  .field-core { transform: scale(.3); }
  .field-aura { opacity: calc(.45 + var(--music-breath, .3) * .25 + var(--music-impact, 0) * .3); }
  .has-contact .field-orbits { animation: field-orbit 80s linear infinite; }
  [data-visual='absence'] .field-weave { opacity: .15; transform: scale(.75); }
  [data-visual='absence'] .field-core { transform: scale(1.9); stroke-opacity: .14; }
  [data-visual='counterflow'] .field-orbits { animation-direction: reverse; }
  [data-visual='counterflow'] .field-weave { transform: rotate(160deg) scale(.85); }
  [data-visual='eclipse'] .field-sun, [data-visual='eleventh'] .field-sun { opacity: 1; transform: scale(calc(1 + var(--music-impact, 0) * .015)); }
  [data-visual='eclipse'] .field-weave, [data-visual='eleventh'] .field-weave { opacity: .1; transform: scale(1.1); }
  [data-visual='eclipse'] .field-stars, [data-visual='eleventh'] .field-stars { opacity: .7; }
  [data-visual='eleventh'] .field-stars { transform: rotate(90deg) scale(1.3); }
  [data-visual='eleventh'] .field-paradox, [data-visual='paradox'] .field-paradox { opacity: 1; }
  [data-visual='paradox'] .field-weave, [data-visual='paradox'] .field-core { opacity: 0; }
  [data-visual='paradox'] .field-orbits { opacity: .25; }
  .discovery-response { min-height: 190px; padding: 2rem 2rem 1rem; }
  .discovery-response > .eyebrow { color: var(--accent); font-size: .58rem; margin-bottom: .8rem; }
  .discovery-response h3 { font-size: clamp(1.3rem, 2.5vw, 2rem); letter-spacing: -.035em; line-height: 1.2; margin-bottom: .8rem; }
  .discovery-response > p:last-child { color: var(--muted); font-size: .88rem; max-width: 45ch; margin: 0; }
  .discovery-bottom { display: flex; justify-content: space-between; align-items: start; gap: 1rem; padding: 0 2rem 1rem; }
  .fragment-archive { padding-top: .3rem; max-width: calc(100% - 60px); }
  .fragment-archive summary { display: flex; align-items: center; gap: 1rem; cursor: pointer; min-height: 44px; color: var(--muted); font: .6rem/1.7 var(--font-mono); }
  .fragment-archive summary > span { color: var(--accent); }
  .fragment-archive ul { margin: 0; padding: .5rem 0 .5rem 1.2rem; color: var(--muted); font: .65rem/2 var(--font-mono); }
  .eleven-control { display: flex; align-items: center; justify-content: center; flex: none; width: 48px; min-height: 48px; margin-left: auto; gap: .4rem; border: 1px solid var(--line); background: var(--surface); color: var(--accent); font: .75rem var(--font-mono); cursor: pointer; }
  .eleven-control > span { font-size: .65rem; }
  .eleven-control:hover { border-color: var(--accent-dim); }
  @keyframes field-orbit { to { transform: rotate(360deg); } }
  @media (max-width: 800px) { .discovery-section { grid-template-columns: 1fr 1.2fr; gap: 2rem; } .discovery-response { padding-inline: 1.3rem; } .discovery-bottom { padding-inline: 1.3rem; } }
  @media (max-width: 680px) { .discovery-section { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 0 3.5rem; } .discovery-intro { padding-top: 0; } .discovery-intro h2 { font-size: 3rem; } .discovery-intro .discovery-hint { margin-top: 1.5rem; } .discovery-response { min-height: 175px; } }
  @media (prefers-reduced-motion: reduce) { .field-orbits, .field-weave, .field-stars, .field-core, .field-sun, .field-paradox { animation: none !important; transition: none !important; } }
</style>
