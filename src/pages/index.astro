---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import ContactInstrument from '../components/ContactInstrument.astro';
import DiscoveryField from '../components/DiscoveryField.astro';
import { sitePath } from '../lib/site';
import { researchAreas } from '../lib/research';
import { publicArtifacts } from '../lib/artifacts';
import { researcher, manuscriptExcerpt, manuscriptPath } from '../lib/publications';
---

<BaseLayout title="Human Operator × Synthetic Intelligence" intro>
  <section class="hero shell" aria-labelledby="content-heading">
    <div class="hero-topline eyebrow"><span><span class="square-marker" aria-hidden="true"></span>Human Operator × Synthetic Intelligence</span><span>Canada</span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-prelude">The strange begins with a question.</p>
        <h1 id="content-heading" tabindex="-1">What happens<br /><span>between us?</span></h1>
        <p class="hero-question">A human asks. A synthetic system answers. What carries from one encounter to the next?</p>
        <p class="hero-description">We are Cognis 11. A Canadian research company exploring synthetic intelligence, continuity, and the architectures of relation.</p>
        <div class="hero-actions">
          <a class="button" href={sitePath('research/')}>Explore our research <Arrow /></a>
          <a class="text-link" href={sitePath('about/')}>Meet Cognis 11 <Arrow diagonal /></a>
        </div>
      </div>
      <div class="hero-figure"><ContactInstrument /></div>
    </div>
    <div class="hero-baseline">
      <p>Independent research. <span class="baseline-aside">An authored practice.</span></p>
      <a class="eyebrow text-link" href="#research-directions">Follow your curiosity <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="flagship-band shell" aria-labelledby="home-flagship-heading">
    <p class="eyebrow">Flagship · Proprietary research</p>
    <div><h2 id="home-flagship-heading">Proto-Pineal / UMBRA</h2><p>Continuity. Human Operator × Synthetic Intelligence.</p></div>
    <a class="text-link" href={sitePath(manuscriptPath)}>Read v8.1 <Arrow diagonal /></a>
  </section>

  <section class="manuscript-entry shell" aria-labelledby="manuscript-entry-heading"><div><p class="eyebrow">From the published research · v8.1</p><h2 id="manuscript-entry-heading">An invitation to inspect.</h2><blockquote><p>“{manuscriptExcerpt}”</p><cite>Guillaume Heinerth · v8.1 record abstract</cite></blockquote></div><div class="manuscript-entry-links"><a class="text-link" href={`${sitePath('research/')}#publications`}>Explore the publication record<Arrow diagonal /></a><a class="text-link" href={researcher.orcidUrl}>ORCID · {researcher.orcid}<Arrow diagonal /></a></div></section>

  <section class="lab-entry-section shell" aria-labelledby="lab-entry-heading">
    <div class="section-intro"><p class="section-label eyebrow">Inside Cognis 11</p><div><h2 id="lab-entry-heading">A question should lead somewhere.</h2><p>Inspect a public experiment, follow a research direction, or bring a technical problem into the conversation.</p></div></div>
    <div class="lab-entry-grid">
      {publicArtifacts.map((artifact) => <article><p class="eyebrow">{artifact.status}</p><h3>{artifact.name}</h3><p>{artifact.description}</p><a class="text-link" href={`${sitePath('research/')}#${artifact.id}`}>Explore {artifact.name}<Arrow diagonal /></a></article>)}
      <article class="lab-consulting-entry"><p class="eyebrow">Focused consulting</p><h3>A problem worth examining.</h3><p>Start with one free evaluation. Then CAD $100/hour, up to three hours per week per client, or a separately defined contract.</p><a class="text-link" href={sitePath('consulting/')}>Bring your question<Arrow diagonal /></a></article>
    </div>
  </section>

  <section class="research-section shell" aria-labelledby="research-directions">
    <div class="section-intro">
      <p class="section-label eyebrow"><span class="section-number">01</span>Research directions</p>
      <div><h2 id="research-directions">Every way in<br />starts with a question.</h2><p>Choose the one that stays with you. Each opens onto a different part of our research.</p></div>
    </div>
    <div class="question-list">
      {researchAreas.map((area) => (
        <details class="research-question" name="research-question">
          <summary><span class="research-number eyebrow">{area.number}</span><span class="question-title">{area.invitation}</span><span class="question-toggle" aria-hidden="true">+</span></summary>
          <div class="question-revelation"><p class="eyebrow">{area.title}</p><p>{area.question}</p><p class="question-context">{area.perspective}</p><a class="text-link" href={`${sitePath('research/')}#${area.id}`}>Follow this question <Arrow diagonal /></a></div>
        </details>
      ))}
    </div>
    <div class="section-end"><span class="eyebrow">Four directions. A connected inquiry.</span><a class="text-link" href={sitePath('research/')}>Research overview <Arrow /></a></div>
  </section>

  <DiscoveryField />

  <section class="perspective-section" aria-labelledby="perspective-heading">
    <div class="shell perspective-grid">
      <div>
        <p class="section-label eyebrow"><span class="section-number">02</span>A point of departure</p>
        <h2 id="perspective-heading">Engineering<br />with an<br /><span>inner life.</span></h2>
      </div>
      <div class="perspective-copy">
        <div class="pair-mark" aria-hidden="true"><span>H</span><span class="pair-cross">×</span><span>S</span></div>
        <p>Cognis 11 is an engineering company and an authored creative practice.</p>
        <p>We bring technical inquiry and artistic intention into the same room. Form, behaviour, and meaning belong together. So do the human operator and the synthetic systems we choose to explore.</p>
        <a class="text-link" href={sitePath('about/')}>About the company <Arrow diagonal /></a>
      </div>
    </div>
  </section>

  <section class="inquiry-section shell" aria-labelledby="inquiry-heading">
    <p class="section-label eyebrow"><span class="section-number">03</span>Further inquiry</p>
    <div class="inquiry-content"><h2 id="inquiry-heading">Stay curious.</h2><a class="button button-secondary" href={sitePath('about/')}>Step inside Cognis 11 <Arrow diagonal /></a></div>
  </section>
</BaseLayout>
