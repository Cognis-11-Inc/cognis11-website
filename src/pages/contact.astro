---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import ReadingQuestions from '../components/ReadingQuestions.astro';
import { contactQuestions } from '../lib/editorial';
import { inquiryRoutes, inquiryMailto } from '../lib/contact';
import { site, sitePath } from '../lib/site';
---

<BaseLayout title="Contact" description="Contact Cognis 11 Inc. at founder@cognis11.xyz for research correspondence and inquiries about the company.">
  <PageHeading number="04" label="Contact" title="An opening for dialogue." description="Bring a question, a difficult mechanism, or something worth building. Reach the founder directly for research, consulting, or a possible collaboration." />
  <div class="shell page-body">
    <section class="contact-panel" aria-labelledby="contact-heading">
      <p class="eyebrow">Direct correspondence</p>
      <div>
        <h2 id="contact-heading">Start with a question.</h2>
        <a class="contact-address" href={`mailto:${site.contactEmail}`}>{site.contactEmail}<Arrow diagonal /></a>
        <p>Write to {site.founder.name}, {site.founder.title.toLowerCase()}, about the company, its research, or a possible conversation.</p>
        <p class="contact-note">This link opens your email app. You can also copy the address into your preferred mail service.</p>
      </div>
    </section>
    <section class="inquiry-routes" aria-labelledby="routes-heading">
      <div class="research-section-heading"><p class="eyebrow">Choose an opening</p><h2 id="routes-heading">What brings you here?</h2><p>Each link prepares a short email outline. Use it as a starting point, add your own words, and send it through your email app.</p></div>
      <div class="inquiry-route-grid">{inquiryRoutes.map((route) => <article id={`inquiry-${route.id}`}><h3>{route.title}</h3><p>{route.description}</p><a class="text-link" href={inquiryMailto(route.subject, route.body)}>{route.action}<Arrow diagonal /></a></article>)}</div>
    </section>
    <section class="editorial-block" aria-labelledby="first-message-heading">
      <p class="eyebrow">A useful first message</p><div><h2 id="first-message-heading">Give the question some context.</h2><p>What are you trying to understand or build? What have you already tried? A specific observation, a public reference, or a concise description helps the conversation begin somewhere concrete.</p><p>For consulting, the first evaluation is free. If deeper documentation or implementation work is needed, agree the scope before a paid engagement begins.</p><a class="text-link" href={sitePath('consulting/')}>Read the consulting arrangement <Arrow diagonal /></a></div>
    </section>
    <ReadingQuestions id="contact-questions" title="A few practical answers." items={contactQuestions} />
    <a class="text-link" href={sitePath('about/')}>Meet the founder <Arrow /></a>
  </div>
</BaseLayout>
