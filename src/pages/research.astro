---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ResearchArtifact from '../components/ResearchArtifact.astro';
import ReadingGrid from '../components/ReadingGrid.astro';
import PublicationLibrary from '../components/PublicationLibrary.astro';
import Arrow from '../components/Arrow.astro';
import { researchAreas } from '../lib/research';
import { publicArtifacts, evidenceReviewed } from '../lib/artifacts';
import { sitePath } from '../lib/site';
import { researchReading } from '../lib/editorial';
---

<BaseLayout title="Research" description="Explore Cognis 11 Inc.’s research directions: synthetic intelligence, computational architectures, continuity, and human–synthetic dynamics.">
  <PageHeading number="01" label="Research" title="Questions worth pursuing." description="Proto-Pineal / UMBRA is the flagship research programme of Cognis 11. Selected public experiments offer another way into the questions behind the company." />
  <div class="shell page-body">
    <nav class="page-index" aria-label="Research sections"><a href="#flagship">The flagship</a><a href="#publications">Published manuscripts</a><a href="#public-work">Public projects</a><a href="#research-directions">Research directions</a><a href="#reading-evidence">Reading the evidence</a></nav>
    <section class="flagship-section" id="flagship" aria-labelledby="flagship-heading">
      <div><p class="eyebrow">Flagship · Proprietary research</p><h2 id="flagship-heading">Proto-Pineal<br /><span>/ UMBRA</span></h2></div>
      <div class="flagship-copy"><p class="flagship-question">What persists across encounters?</p><p>The flagship of Cognis 11 explores continuity and the relation between a human operator and synthetic intelligence.</p><p class="flagship-boundary">Read the published manuscripts through v8.1 below. The engine and current implementation remain proprietary.</p><a class="text-link" href="#publications">Read the published research <Arrow diagonal /></a></div>
    </section>
    <PublicationLibrary />
    <section class="artifact-section" id="public-work" aria-labelledby="public-work-heading">
      <div class="research-section-heading"><p class="eyebrow">Public experiments &amp; engineering</p><h2 id="public-work-heading">Work you can inspect.</h2><p>Explore HOUND’s network observation experiment, Digital Bee Hive’s collective-agent design, the deterministic world of Möbius Automata, and Phalanx’s game-AI testbed. Each public project carries its own scope.</p></div>
      {publicArtifacts.map((artifact) => <ResearchArtifact artifact={artifact} />)}
      <p class="evidence-date">Sources reviewed <time datetime={evidenceReviewed}>November 5, 2026</time>. Descriptions reflect the cited project records.</p>
    </section>
    <div class="research-section-heading" id="research-directions"><p class="eyebrow">Research directions</p><h2>Four connected questions.</h2><p>These perspectives describe the inquiry behind Cognis 11. Each opens a way to think about a system, examine an interpretation, and ask a more precise question.</p></div>
    <div class="research-topics">
      {researchAreas.map((area) => (
        <section class="research-topic" id={area.id} aria-labelledby={`${area.id}-heading`}>
          <span class="eyebrow research-number">{area.number}</span>
          <div><h2 id={`${area.id}-heading`}>{area.title}</h2><p class="direction-question">{area.question}</p><p>{area.perspective}</p><p>{area.context}</p><details class="direction-inquiry"><summary>Questions to carry into the work <span aria-hidden="true">+</span></summary><ul>{area.inquiries.map((question) => <li>{question}</li>)}</ul></details></div>
        </section>
      ))}
    </div>
    <ReadingGrid id="reading-evidence" label="Research practice" title="An observation. A mechanism. A claim." intro="The public artifacts are invitations to inspect the work. Read them with the same curiosity you would bring to a new question." items={researchReading} />
    <div class="editorial-closing"><p>Have an observation that changes the question?</p><a class="text-link" href={sitePath('contact/')}>Open a research conversation <Arrow diagonal /></a></div>
  </div>
</BaseLayout>
